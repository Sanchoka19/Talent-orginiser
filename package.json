{
  "name": "talent-organizer-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:web": "pnpm --filter @talent/web dev",
    "dev:api": "pnpm --filter @talent/api dev",
    "prisma:generate": "pnpm --filter @talent/api prisma:generate",
    "prisma:migrate": "pnpm --filter @talent/api prisma:migrate",
    "prisma:studio": "pnpm --filter @talent/api prisma:studio",
    "prisma:seed": "pnpm --filter @talent/api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@11.9.0"
}
